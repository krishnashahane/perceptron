# Required for production session signing.
# Use at least 32 random characters.
PERCEPTRON_SECRET="replace-with-a-long-random-secret"

# Production demo-account passwords.
# In development, built-in demo passwords are used when these are omitted.
PERCEPTRON_PW_ANALYST="replace-with-a-strong-password"
PERCEPTRON_PW_INVESTIGATOR="replace-with-a-strong-password"
PERCEPTRON_PW_ADMIN="replace-with-a-strong-password"

# Optional AI copilot. Leave empty for the fully offline deterministic copilot.
GEMINI_API_KEY=""

# Optional Gemini model override.
GEMINI_MODEL="gemini-2.5-flash"
